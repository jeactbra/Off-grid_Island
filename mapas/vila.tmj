", "type": "sprite", "x": 571.0, "y": 431.0, "width": 0, "height": 0, "point": true, "rotation": 0, "visible": true, "properties": [{"name": "quadro", "type": "int", "value": 0}, {"name": "escala_x", "type": "float", "value": 1.0}, {"name": "escala_y", "type": "float", "value": 1.0}, {"name": "velocidade", "type": "float", "value": 1.0}, {"name": "profundidade", "type": "string", "value": "ordenado"}, {"name": "solido", "type": "bool", "value": false}]}, {"id": 1416, "name": "wood", "type": "sprite", "x": 579.0, "y": 429.97318, "width": 0, "height": 0, "point": true, "rotation": 0, "visible": true, "properties": [{"name": "quadro", "type": "int", "value": 0}, {"name": "escala_x", "type": "float", "value": -1.0}, {"name": "escala_y", "type": "float", "value": 1.0}, {"name": "velocidade", "type": "float", "value": 1.0}, {"name": "profundidade", "type": "string", "value": "ordenado"}, {"name": "solido", "type": "bool", "value": false}]}, {"id": 1417, "name": "spr_deco_charactershadow", "type": "sprite", "x": 613.0, "y": 415.88892, "width": 0, "height": 0, "point": true, "rotation": 0, "visible": true, "properties": [{"name": "quadro", "type": "int", "value": 0}, {"name": "escala_x", "type": "float", "value": 1.0}, {"name": "escala_y", "type": "float", "value": 1.0}, {"name": "velocidade", "type": "float", "value": 1.0}, {"name": "profundidade", "type": "string", "value": "ordenado"}, {"name": "solido", "type": "bool", "value": false}]}, {"id": 1418, "name": "wood", "type": "sprite", "x": 605.0, "y": 413.82135, "width": 0, "height": 0, "point": true, "rotation": 0, "visible": true, "properties": [{"name": "quadro", "type": "int", "value": 0}, {"name": "escala_x", "type": "float", "value": 1.0}, {"name": "escala_y", "type": "float", "value": 1.0}, {"name": "velocidade", "type": "float", "value": 1.0}, {"name": "profundidade", "type": "string", "value": "ordenado"}, {"name": "solido", "type": "bool", "value": false}]}]}, {"id": 16, "name": "objetos", "type": "objectgroup", "x": 0, "y": 0, "opacity": 1, "visible": true, "draworder": "topdown", "objects": [{"name": "jogador", "type": "inicio", "x": 344, "y": 504, "id": 5000, "width": 0, "height": 0, "point": true, "rotation": 0, "visible": true, "properties": []}, {"name": "terminal_moinho", "type": "terminal", "x": 648, "y": 328, "id": 5001, "width": 0, "height": 0, "point": true, "rotation": 0, "visible": true, "properties": [{"name": "missao", "type": "string", "value": "vila_programa_status"}, {"name": "rotulo", "type": "string", "value": "Painel do Moinho G1"}, {"name": "equipamento", "type": "string", "value": "Moinho G1"}]}, {"name": "quadro_avisos", "type": "quadro", "x": 568, "y": 472, "id": 5002, "width": 0, "height": 0, "point": true, "rotation": 0, "visible": true, "properties": []}, {"name": "portao_campo_solar", "type": "portao", "x": 120, "y": 280, "id": 5003, "width": 0, "height": 0, "point": true, "rotation": 0, "visible": true, "properties": [{"name": "destino", "type": "string", "value": "Campo Solar"}]}, {"name": "lia", "type": "npc", "x": 600, "y": 360, "id": 5004, "width": 0, "height": 0, "point": true, "rotation": 0, "visible": true, "properties": [{"name": "rotulo", "type": "string", "value": "Lia"}, {"name": "funcao", "type": "string", "value": "Técnica da Vila"}, {"name": "visual", "type": "string", "value": "longhair"}, {"name": "comportamento", "type": "string", "value": "parado"}, {"name": "acao", "type": "string", "value": "idle"}, {"name": "missao", "type": "string", "value": "sim"}]}, {"name": "rosa", "type": "npc", "x": 840, "y": 88, "id": 5005, "width": 0, "height": 0, "point": true, "rotation": 0, "visible": true, "properties": [{"name": "rotulo", "type": "string", "value": "Rosa"}, {"name": "visual", "type": "string", "value": "curlyhair"}, {"name": "comportamento", "type": "string", "value": "parado"}, {"name": "acao", "type": "string", "value": "watering"}, {"name": "falas", "type": "string", "value": "[\"As plantas tamb\\u00e9m precisam de energia: sol, \\u00e1gua e paci\\u00eancia.\", \"Quando a bomba d'\\u00e1gua voltar a funcionar, regar vai ser bem mais f\\u00e1cil!\"]"}]}, {"name": "tito", "type": "npc", "x": 472, "y": 696, "id": 5006, "width": 0, "height": 0, "point": true, "rotation": 0, "visible": true, "properties": [{"name": "rotulo", "type": "string", "value": "Tito"}, {"name": "visual", "type": "string", "value": "bowlhair"}, {"name": "comportamento", "type": "string", "value": "parado"}, {"name": "acao", "type": "string", "value": "reeling"}, {"name": "falas", "type": "string", "value": "[\"Shh... os peixes ouvem tudo.\", \"Antigamente o cais tinha luz a noite inteira. Saudade.\"]"}]}, {"name": "bruna", "type": "npc", "x": 984, "y": 472, "id": 5007, "width": 0, "height": 0, "point": true, "rotation": 0, "visible": true, "properties": [{"name": "rotulo", "type": "string", "value": "Bruna"}, {"name": "visual", "type": "string", "value": "spikeyhair"}, {"name": "comportamento", "type": "string", "value": "parado"}, {"name": "acao", "type": "string", "value": "hammering"}, {"name": "falas", "type": "string", "value": "[\"Uma pe\\u00e7a de cada vez, na ordem certa. Igual a programar, n\\u00e9?\", \"Esse martelo j\\u00e1 consertou metade dos moinhos da ilha.\"]"}]}, {"name": "nico", "type": "npc", "x": 488, "y": 504, "id": 5008, "width": 0, "height": 0, "point": true, "rotation": 0, "visible": true, "properties": [{"name": "rotulo", "type": "string", "value": "Nico"}, {"name": "visual", "type": "string", "value": "mophair"}, {"name": "comportamento", "type": "string", "value": "vagar"}, {"name": "raio", "type": "string", "value": "4"}, {"name": "falas", "type": "string", "value": "[\"Voc\\u00ea \\u00e9 quem vai ligar a luz? Eu quero ver o moinho girar!\", \"Eu sei contar at\\u00e9 mil! Mas o computador conta mais r\\u00e1pido.\"]"}]}, {"name": "seu_jair", "type": "npc", "x": 424, "y": 392, "id": 5009, "width": 0, "height": 0, "point": true, "rotation": 0, "visible": true, "properties": [{"name": "rotulo", "type": "string", "value": "Seu Jair"}, {"name": "visual", "type": "string", "value": "shorthair"}, {"name": "comportamento", "type": "string", "value": "parado"}, {"name": "acao", "type": "string", "value": "waiting"}, {"name": "falas", "type": "string", "value": "[\"No meu tempo, a ilha toda era iluminada pelo vento.\", \"O computador faz exatamente o que voc\\u00ea manda. Nem mais, nem menos.\"]"}]}, {"name": "davi", "type": "npc", "x": 312, "y": 504, "id": 5010, "width": 0, "height": 0, "point": true, "rotation": 0, "visible": true, "properties": [{"name": "rotulo", "type": "string", "value": "Davi"}, {"name": "visual", "type": "string", "value": "spikeyhair"}, {"name": "comportamento", "type": "string", "value": "rota"}, {"name": "rota", "type": "string", "value": "[[19, 31], [44, 30], [66, 30], [44, 31]]"}, {"name": "falas", "type": "string", "value": "[\"Estou levando recados de um lado a outro da Vila.\", \"Dizem que tem um ba\\u00fa escondido perto do cais...\"]"}]}, {"name": "mara", "type": "npc", "x": 872, "y": 168, "id": 5011, "width": 0, "height": 0, "point": true, "rotation": 0, "visible": true, "properties": [{"name": "rotulo", "type": "string", "value": "Mara"}, {"name": "visual", "type": "string", "value": "longhair"}, {"name": "comportamento", "type": "string", "value": "vagar"}, {"name": "raio", "type": "string", "value": "3"}, {"name": "falas", "type": "string", "value": "[\"As ovelhas n\\u00e3o ligam para energia. Eu ligo!\", \"J\\u00e1 viu o moinho grande girando? \\u00c9 lindo.\"]"}]}, {"name": "caio", "type": "npc", "x": 136, "y": 536, "id": 5012, "width": 0, "height": 0, "point": true, "rotation": 0, "visible": true, "properties": [{"name": "rotulo", "type": "string", "value": "Caio"}, {"name": "visual", "type": "string", "value": "bowlhair"}, {"name": "comportamento", "type": "string", "value": "parado"}, {"name": "acao", "type": "string", "value": "axe"}, {"name": "falas", "type": "string", "value": "[\"Madeira para as cercas da horta.\", \"Lenha queima r\\u00e1pido. O vento n\\u00e3o acaba nunca.\"]"}]}, {"name": "lu", "type": "npc", "x": 136, "y": 712, "id": 5013, "width": 0, "height": 0, "point": true, "rotation": 0, "visible": true, "properties": [{"name": "rotulo", "type": "string", "value": "Lu"}, {"name": "visual", "type": "string", "value": "curlyhair"}, {"name": "comportamento", "type": "string", "value": "parado"}, {"name": "acao", "type": "string", "value": "mining"}, {"name": "falas", "type": "string", "value": "[\"Cobre para os fios novos da Vila!\", \"Cada fio leva energia de um lugar para outro.\"]"}]}]}]}